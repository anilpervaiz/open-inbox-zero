# Copy to .env and fill locally. Never commit the populated file.
# Use a long random URL-safe value (letters, numbers, hyphens, underscores).
POSTGRES_PASSWORD=
# Required for real sign-in and token storage. Generate both independently:
# openssl rand -base64 32
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
# Public HTTPS origin used for OAuth callbacks; local development may use http://localhost:3000.
BETTER_AUTH_URL=
# Bring your own Google and/or Microsoft OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Google Pub/Sub push verification and watch setup (required for Gmail push sync).
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION=
# Optional model: emulator, google, openai, anthropic, or ollama.
LLM_PROVIDER=emulator
LLM_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
# Optional secret for detailed health checks. Public liveness needs no token.
HEALTH_TOKEN=
