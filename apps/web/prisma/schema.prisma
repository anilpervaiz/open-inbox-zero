generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogicalOperator {
  AND
  OR
}

enum SystemType {
  TO_REPLY
  NEWSLETTER
  MARKETING
  CALENDAR
  RECEIPT
  NOTIFICATION
  COLD_EMAIL
}

enum ActionType {
  ARCHIVE
  LABEL
  REPLY
  SEND_EMAIL
  FORWARD
  DRAFT_EMAIL
  MARK_SEEN
  MARK_SPAM
  CALL_WEBHOOK
  TRACK_THREAD
}

enum ExecutedRuleStatus {
  PENDING
  APPLIED
  SKIPPED
  REJECTED
  ERROR
}

enum ExecutedActionStatus {
  PENDING
  COMPLETED
  SKIPPED
  FAILED
}

enum DelayedActionStatus {
  PENDING
  CLAIMED
  COMPLETED
  FAILED
  UNCERTAIN
  CANCELLED
}

enum GroupItemType {
  FROM
  SUBJECT
  BODY
}

enum GroupItemSource {
  USER
  AI_LEARNED
}

enum ThreadTrackerType {
  NEEDS_REPLY
  AWAITING_REPLY
}

enum ReplyTrackingEventKind {
  INCOMING
  SENT
}

enum ReplyLabelOperation {
  ADD
  REMOVE
}

enum ColdEmailStatus {
  AI_LABELED_COLD
  USER_MARKED_COLD
  NOT_COLD
}

enum NewsletterStatus {
  AUTO_ARCHIVE
  AUTO_ARCHIVE_AND_LABEL
  UNSUBSCRIBED
  APPROVED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  emailVerified Boolean        @default(false)
  image         String?
  sessions      AuthSession[]
  authAccounts  AuthAccount[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailAccounts EmailAccount[]
  apiKeys       UserApiKey[]
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserApiKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([userId])
}

model EmailAccount {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                String               @unique
  provider             String               // "google" | "microsoft" | "emulator"
  encryptedAccessToken String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  lastSyncedHistoryId  String?
  about                String?              // User profile context for AI drafting
  signature            String?
  autoCategorizeSenders Boolean             @default(true)
  coldEmailBlocker     String               @default("LABEL_AND_ARCHIVE") // "DISABLED" | "LABEL" | "LABEL_AND_ARCHIVE"
  coldEmailPrompt      String?
  rules                Rule[]
  groups               Group[]
  executedRules        ExecutedRule[]
  threadTrackers       ThreadTracker[]
  replyTrackingEvents  ReplyTrackingEvent[]
  replyThreadStates    ReplyThreadState[]
  replyLabelSyncs      ReplyLabelSync[]
  newsletters          Newsletter[]
  coldEmails           ColdEmail[]
  knowledge            Knowledge[]
  replyMemories        ReplyMemory[]
  feedbacks            ClassificationFeedback[]
  providerSubscriptions ProviderSubscription[]
  emailMessages        EmailMessage[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model ProviderSubscription {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  subscriptionId String       @unique
  clientStateHash String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([emailAccountId])
}

model Rule {
  id                  String           @id @default(cuid())
  name                String
  emailAccountId      String
  emailAccount        EmailAccount     @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  systemType          SystemType?
  instructions        String?          // Natural-language AI rule prompt
  automate            Boolean          @default(true)
  runOnThreads        Boolean          @default(true)
  conditionalOperator LogicalOperator  @default(AND)
  from                String?          // Static glob/regex pattern
  to                  String?
  subject             String?
  body                String?
  groupId             String?
  group               Group?           @relation(fields: [groupId], references: [id])
  actions             Action[]
  executedRules       ExecutedRule[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([name, emailAccountId])
}

model Action {
  id          String     @id @default(cuid())
  ruleId      String
  rule        Rule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type        ActionType
  label       String?    // Can be static string or dynamic prompt instruction
  subject     String?
  content     String?    // Can be static template or dynamic prompt instruction
  to          String?
  cc          String?
  bcc         String?
  url         String?    // For CALL_WEBHOOK
  delayMinutes Int?      // For delayed actions
  autoSend     Boolean    @default(false) // Explicit opt-in to outbound sending
}

model Group {
  id             String       @id @default(cuid())
  name           String
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  items          GroupItem[]
  rules          Rule[]
}

model GroupItem {
  id        String          @id @default(cuid())
  groupId   String
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type      GroupItemType   @default(FROM)
  value     String          // e.g. "billing@stripe.com" or "*@github.com"
  exclude   Boolean         @default(false)
  source    GroupItemSource @default(USER)
  createdAt DateTime        @default(now())

  @@unique([groupId, type, value])
}

model ExecutedRule {
  id                String             @id @default(cuid())
  emailAccountId    String
  emailAccount      EmailAccount       @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  ruleId            String?
  rule              Rule?              @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  threadId          String
  messageId         String
  sourceMessageId   String?            // Real mail ID when messageId identifies an internal audit
  status            ExecutedRuleStatus @default(PENDING)
  automated         Boolean            @default(true)
  reason            String?
  matchReasons      Json?              // MatchReason[]
  selectionMetadata Json?              // RuleSelectionMetadata
  actionItems       ExecutedAction[]
  replyLabelSync    ReplyLabelSync?
  createdAt         DateTime           @default(now())

  @@unique([emailAccountId, threadId, messageId])
}

model ExecutedAction {
  id                 String               @id @default(cuid())
  executedRuleId     String
  executedRule       ExecutedRule         @relation(fields: [executedRuleId], references: [id], onDelete: Cascade)
  type               ActionType
  status             ExecutedActionStatus @default(PENDING)
  label              String?
  labelOperation     ReplyLabelOperation? // Tracker audit add/remove; null is a normal label action
  subject            String?
  content            String?
  to                 String?
  cc                 String?
  bcc                String?
  url                String?
  draftId            String?              // Provider draft ID for updates/cleanup
  draftThreadId      String?              // Provider thread containing the created draft
  sentMessageId      String?
  error              String?
  undoSnapshot       Json?                // Provider state captured before an action, for safe undo
  executionStartedAt DateTime?
  executedAt         DateTime?
  delayedAction      DelayedAction?
}

// A scheduled provider mutation is claimed once; uncertain outcomes are never
// retried automatically because an external mail provider cannot join our transaction.
model DelayedAction {
  id               String              @id @default(cuid())
  executedActionId String              @unique
  executedAction   ExecutedAction      @relation(fields: [executedActionId], references: [id], onDelete: Cascade)
  sourceActionId   String
  sourceFingerprint String
  protectedSenders String[]            @default([])
  dueAt            DateTime
  status           DelayedActionStatus @default(PENDING)
  claimToken       String?
  leaseUntil       DateTime?
  startedAt        DateTime?
  learningPending  Boolean             @default(false)
  learningNextAttemptAt DateTime?
  trackerPending   Boolean             @default(false)
  trackerNextAttemptAt DateTime?
  attempts         Int                 @default(0)
  error            String?
  createdAt        DateTime            @default(now())

  @@index([status, dueAt])
}

model ThreadTracker {
  id             String            @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount      @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  threadId       String
  messageId      String
  type           ThreadTrackerType
  resolved       Boolean           @default(false)
  sentAt         DateTime
  followUpAt     DateTime?

  @@unique([emailAccountId, threadId, messageId])
}

// Durable input events permit idempotent replay when provider notifications arrive out of order.
model ReplyTrackingEvent {
  id             String                 @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount           @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  threadId       String
  messageId      String
  kind           ReplyTrackingEventKind
  sender         String
  recipients     String[]
  occurredAt     DateTime
  requiresReply  Boolean                @default(false)
  requiresReplySuppressed Boolean        @default(false)
  ignored        Boolean                @default(false)
  followUpAt     DateTime?
  createdAt      DateTime               @default(now())

  @@unique([emailAccountId, threadId, messageId])
  @@index([emailAccountId, threadId, occurredAt])
}

model ReplyThreadState {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  threadId       String
  revision       Int          @default(0)
  needsReply     Int          @default(0)
  awaitingReply  Int          @default(0)

  @@unique([emailAccountId, threadId])
}

// The audit exists before any provider label calls. Uncertain calls are never replayed automatically.
model ReplyLabelSync {
  id                String              @id @default(cuid())
  emailAccountId    String
  emailAccount      EmailAccount        @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  threadId          String
  sourceMessageId   String
  revision          Int
  executedRuleId    String              @unique
  executedRule      ExecutedRule        @relation(fields: [executedRuleId], references: [id], onDelete: Cascade)
  status            DelayedActionStatus @default(PENDING)
  claimToken        String?
  leaseUntil        DateTime?
  startedAt         DateTime?
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  error             String?
  createdAt         DateTime            @default(now())

  @@unique([emailAccountId, threadId, revision])
  @@index([status, createdAt])
}

model Newsletter {
  id              String            @id @default(cuid())
  emailAccountId  String
  emailAccount    EmailAccount      @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  fromEmail       String
  status          NewsletterStatus?
  unsubscribeUrl  String?
  listUnsubscribe String?
  messageCount    Int               @default(0)
  readCount       Int               @default(0)
  archivedCount   Int               @default(0)

  @@unique([emailAccountId, fromEmail])
}

model ColdEmail {
  id             String          @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount    @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  fromEmail      String
  threadId       String
  messageId      String
  status         ColdEmailStatus @default(AI_LABELED_COLD)
  reason         String?
  createdAt      DateTime        @default(now())

  @@unique([emailAccountId, fromEmail])
}

model Knowledge {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  title          String
  content        String       // Facts, pricing, FAQ, or policy text used when drafting replies
  updatedAt      DateTime     @updatedAt
}

model ReplyMemory {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  promptSummary  String       // What the incoming email asked
  replyText      String       // How the user actually replied (style/tone example)
  createdAt      DateTime     @default(now())
}

model ClassificationFeedback {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  fromEmail      String
  subject        String
  correctRuleId  String?
  wrongRuleId    String?
  note           String?
  createdAt      DateTime     @default(now())
}

model EmailMessage {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  threadId       String
  messageId      String
  fromEmail      String
  fromName       String?
  toEmail        String
  ccEmail        String?
  headerMessageId String?
  inReplyTo      String?
  references     String?
  subject        String
  snippet        String
  textBody       String
  htmlBody       String?
  contentType    String?
  attachmentNames String[] @default([])
  attachments     EmailAttachment[]
  mimeTypes      String[] @default([])
  labels         String[]
  unread         Boolean      @default(true)
  archived       Boolean      @default(false)
  listUnsubscribe String?
  listUnsubscribePost String?
  internalDate   DateTime

  @@unique([emailAccountId, messageId])
}

// Cooperative fail-closed lock for provider mutations and undo on a thread.
// A lock left by a crashed process requires explicit operator recovery.
model ThreadExecutionLock {
  id             String   @id @default(cuid())
  emailAccountId String
  threadId       String
  ownerClaimToken String?
  ownerCleanupJobId String?
  ownerTrackerJobId String?
  createdAt      DateTime @default(now())

  @@unique([emailAccountId, threadId])
}

// Binary attachment data belongs to a mailbox-scoped message and is deleted with it.
model EmailAttachment {
  id             String       @id @default(cuid())
  emailMessageId String
  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  name           String
  contentType    String
  content        Bytes

  @@index([emailMessageId])
}

// Explicit operator attestations when an abandoned immediate execution is recovered.
model ExecutionRecovery {
  id                 String   @id @default(cuid())
  emailAccountId     String
  threadId           String
  abandonedLockId    String
  operator           String
  stoppedEvidence    String
  affectedExecutions Int
  createdAt          DateTime @default(now())

  @@index([emailAccountId, threadId])
}

enum CleanupJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_ERROR
  UNDONE
}

enum CleanupThreadStatus {
  PENDING
  STARTED
  COMPLETED
  SKIPPED
  FAILED
  UNDONE
}

// Cleanup jobs are scoped to one email account and keep reversible per-thread snapshots.
model CleanupJob {
  id             String           @id @default(cuid())
  emailAccountId String
  olderThan      DateTime
  mode           String
  status         CleanupJobStatus @default(PENDING)
  threads        CleanupThread[]
  createdAt      DateTime         @default(now())

  @@index([emailAccountId, createdAt])
}

model CleanupThread {
  id              String              @id @default(cuid())
  jobId           String
  job             CleanupJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  threadId        String
  status          CleanupThreadStatus @default(PENDING)
  undoSnapshot    Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  error           String?

  @@unique([jobId, threadId])
}

model CleanupRecovery {
  id               String   @id @default(cuid())
  emailAccountId   String
  cleanupJobId     String
  operator         String
  stoppedEvidence  String
  releasedLocks    Int
  createdAt        DateTime @default(now())

  @@index([emailAccountId, cleanupJobId])
}
